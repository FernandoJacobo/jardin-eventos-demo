---
import Icon from './Icon.astro';
import { site, waLink } from '@/config/site';
const anio = new Date().getFullYear();
---
<section class="cta-final" aria-labelledby="cta-titulo">
  <div class="container cta-inner reveal">
    <h2 id="cta-titulo">¿Ya tienes fecha en mente? <em>Hablemos.</em></h2>
    <div class="cta-actions">
      <a class="btn btn-gold btn-lg" href="#disponibilidad">Solicitar fecha</a>
      <a class="btn btn-ghost btn-lg" href={waLink(`Hola, me gustaría recibir información y cotizar un evento en ${site.name}.`)} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> WhatsApp
      </a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="brand brand-footer">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.2"></circle><path d="M16 25V12m0 6c-3-.4-5.5-2.6-6-6 3.4.2 5.6 2.5 6 6Zm0-3c3-.4 5.5-2.6 6-6-3.4.2-5.6 2.5-6 6Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>{site.name}</span>
      </p>
      <p>Jardín de eventos para bodas, XV años, bautizos y eventos corporativos.</p>
    </div>
    <ul class="social" aria-label="Redes sociales">
      <li><a href={site.redes.facebook} aria-label="Facebook (enlace de ejemplo)"><Icon name="facebook" /></a></li>
      <li><a href={site.redes.instagram} aria-label="Instagram (enlace de ejemplo)"><Icon name="instagram" /></a></li>
      <li><a href={site.redes.tiktok} aria-label="TikTok (enlace de ejemplo)"><Icon name="tiktok" /></a></li>
    </ul>
    <div class="footer-links">
      <a href={site.avisoPrivacidad}>Aviso de privacidad</a>
      <p>© {anio} {site.name}. Marca ficticia.</p>
    </div>
  </div>
  <p class="credit container">{site.credito.texto} · <a href={site.credito.url} target="_blank" rel="noopener">{site.credito.url}</a></p>
</footer>

<a class="wa-float" href={waLink(`Hola, me gustaría recibir información y cotizar un evento en ${site.name}.`)} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
  <Icon name="whatsapp" />
</a>
