---
import Icon from './Icon.astro';
import { site, waLink } from '@/config/site';

const enlaces = [
  { href: '#por-que', texto: 'Nosotros' },
  { href: '#eventos', texto: 'Eventos' },
  { href: '#galeria', texto: 'Galería' },
  { href: '#paquetes', texto: 'Paquetes' },
  { href: '#ubicacion', texto: 'Ubicación' },
  { href: '#preguntas', texto: 'Preguntas' },
];
---
<header class="site-header" data-header>
  <p class="demo-bar">Sitio de ejemplo (demo) · marca, precios y datos ficticios</p>
  <div class="header-inner container">
    <a class="brand" href="#inicio" aria-label={`${site.name}, ir al inicio`}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.2"></circle><path d="M16 25V12m0 6c-3-.4-5.5-2.6-6-6 3.4.2 5.6 2.5 6 6Zm0-3c3-.4 5.5-2.6 6-6-3.4.2-5.6 2.5-6 6Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>{site.name}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="menu" aria-label="Principal">
      <ul>
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
      <a class="btn btn-gold btn-sm" href="#disponibilidad">Solicitar fecha</a>
      <a class="btn btn-wa btn-sm" href={waLink(`Hola, me gustaría recibir información y cotizar un evento en ${site.name}.`)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        Cotizar por WhatsApp
      </a>
    </nav>
  </div>
</header>
