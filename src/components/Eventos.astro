---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { eventos } from '@/data/contenido';
---
<section class="section section-dark" id="eventos" aria-labelledby="eventos-titulo">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Tipos de evento</p>
      <h2 id="eventos-titulo">Un escenario para cada <em>momento importante</em></h2>
    </header>
    <div class="events">
      {
        eventos.map((e, i) => (
          <article class="event-card reveal" style={`--i: ${i}`}>
            <Picture src={e.foto} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 1100px) 280px, (min-width: 640px) 45vw, 90vw" alt={e.alt} />
            <div class="event-body">
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
              <a class="event-link" href="#disponibilidad" data-evento={e.valor}>
                Consultar fecha <Icon name="flecha" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
